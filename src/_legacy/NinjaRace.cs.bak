using System.Collections.Generic;
using WcsInfinity.Races;

namespace WcsInfinity.Races.Behaviors;

// Пример расы с КАСТОМНЫМ поведением (не только пассивки из JSON).
public class NinjaRace : IRace
{
    public int Id => 9;
    public string Name => "Ниндзя";
    public string Lore => "Тень среди врагов.";
    public RaceTier Tier => RaceTier.T1_Spark;
    public int RequiredLevelToUnlock => 0;

    public IReadOnlyList<Ability> Abilities { get; } = new List<Ability>
    {
        new() { Name = "Уворот", Type = AbilityType.Passive, MaxLevel = 8,
                Description = "Шанс уклониться от урона." },
        new() { Name = "Скрытность", Type = AbilityType.Passive, MaxLevel = 8,
                Description = "Частичная невидимость в покое." },
        new() { Name = "Телепорт за спину", Type = AbilityType.Ultimate, MaxLevel = 1,
                CooldownSeconds = 35f, Description = "Телепорт за спину врага в прицеле." }
    };

    public void OnHurt(GameContext ctx, DamageInfo dmg)
    {
        int dodge = ctx.SkillLevel(0);
        if (System.Random.Shared.NextDouble() < dodge * 0.03)
            dmg.Damage = 0;
    }

    public void OnUltimate(GameContext ctx)
    {
        var slot = ctx.AttackerSlot ?? 0;
        var (x, y, z) = ctx.Engine.GetAimEndPosition(slot);
        ctx.Engine.Teleport(slot, x, y, z);
        ctx.Engine.SpawnParticle("particles/ninja_smoke.vpcf", x, y, z);
        ctx.Engine.PrintToCenter(slot, "🥷 Телепорт!");
    }
}
