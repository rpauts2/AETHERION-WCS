using System.Collections.Generic;

namespace WcsInfinity.Races;

public enum RaceTier { T1_Spark = 1, T2_Combo = 2, T3_Power = 3, Guild = 4 }

// Описание одной способности расы
public class Ability
{
    public string Name { get; set; } = "";
    public string Description { get; set; } = "";
    public int MaxLevel { get; set; } = 8;
    public AbilityType Type { get; set; } = AbilityType.Passive;
    public float CooldownSeconds { get; set; } = 0f; // для active/ultimate
}

public enum AbilityType { Passive, Active, Ultimate }

// Контракт расы. Расы реализуют этот интерфейс ИЛИ грузятся data-driven из JSON.
public interface IRace
{
    int Id { get; }
    string Name { get; }
    string Lore { get; }
    RaceTier Tier { get; }
    int RequiredLevelToUnlock { get; } // порог дивизиона
    IReadOnlyList<Ability> Abilities { get; }

    // Хуки геймплея — движок вызывает их у активной расы игрока
    void OnSpawn(GameContext ctx) {}
    void OnKill(GameContext ctx) {}
    void OnHurt(GameContext ctx, DamageInfo dmg) {}      // модификация урона
    void OnUltimate(GameContext ctx) {}                  // нажата кнопка ульты
    void OnTick(GameContext ctx) {}
}
