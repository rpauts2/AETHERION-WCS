using System;
using System.IO;
using System.Linq;
using CounterStrikeSharp.API;
using CounterStrikeSharp.API.Core;
using CounterStrikeSharp.API.Modules.Commands;
using CounterStrikeSharp.API.Modules.Utils;
using WcsInfinity.Models;
using WcsInfinity.Races;
using WcsInfinity.Systems;
using WcsInfinity.Database;

namespace WcsInfinity.Core;

public class WcsInfinityPlugin : BasePlugin
{
    public override string ModuleName => "WCS: Infinity";
    public override string ModuleVersion => "0.1.0-mvp";
    public override string ModuleAuthor => "WCS Infinity Team";

    private readonly RaceManager _races = new();
    private readonly RouletteSystem _roulette = new();
    private IPlayerStore _store = null!;
    private readonly Dictionary<ulong, PlayerData> _online = new();

    public override void Load(bool hotReload)
    {
        var cfgDir = Path.Combine(ModuleDirectory, "..", "..", "configs");
        _races.LoadFromFile(Path.Combine(cfgDir, "races.json"));
        Console.WriteLine($"[WCS] Загружено рас: {_races.Count}");

        _store = new SqlitePlayerStore(Path.Combine(ModuleDirectory, "wcs.db"));
        _store.Init();

        // Хуки событий CounterStrikeSharp
        RegisterEventHandler<EventPlayerDeath>(OnPlayerDeath);
        RegisterEventHandler<EventPlayerSpawn>(OnPlayerSpawn);
        RegisterEventHandler<EventRoundEnd>(OnRoundEnd);

        // Команды чата
        AddCommand("css_wcs", "Меню рас", CmdWcsMenu);
        AddCommand("css_races", "Сменить расу", CmdRaces);
        AddCommand("css_rank", "Ваш ранг", CmdRank);
        AddCommand("css_shop", "Рулетка/магазин", CmdShop);
        AddCommand("css_ult", "Активировать ультимейт", CmdUlt);
        AddCommand("css_reset", "Сбросить навыки", CmdReset);

        Console.WriteLine("[WCS] Infinity загружен.");
    }

    private PlayerData GetData(CCSPlayerController p)
    {
        var sid = p.SteamID;
        if (!_online.TryGetValue(sid, out var data))
        {
            data = _store.Load(sid) ?? new PlayerData { SteamId = sid, Name = p.PlayerName };
            _online[sid] = data;
        }
        return data;
    }

    private HookResult OnPlayerDeath(EventPlayerDeath ev, GameEventInfo info)
    {
        var attacker = ev.Attacker;
        if (attacker == null || !attacker.IsValid) return HookResult.Continue;

        var data = GetData(attacker);
        var def = _races.Get(data.CurrentRaceId);
        if (def == null) return HookResult.Continue;
        var rp = data.GetRace(data.CurrentRaceId);

        long xp = LevelSystem.XpKill + (ev.Headshot ? LevelSystem.XpHeadshot : 0);
        long gold = EconomySystem.GoldKill + (ev.Headshot ? EconomySystem.GoldHeadshot : 0);
        EconomySystem.AddGold(data, gold);
        int up = LevelSystem.AddXp(data, rp, def.TierEnum, xp);

        if (up > 0)
            attacker.PrintToCenter($"⬆ {def.Name} — уровень {rp.Level}! (+{up})");
        attacker.PrintToChat($" \x04[WCS]\x01 +{xp} XP, +{gold} золота. Раса: {def.Name} ур.{rp.Level}");

        // вызов поведенческого хука расы
        _races.GetBehavior(data.CurrentRaceId)?.OnKill(BuildCtx(data, rp));
        return HookResult.Continue;
    }

    private HookResult OnPlayerSpawn(EventPlayerSpawn ev, GameEventInfo info)
    {
        var p = ev.Userid;
        if (p == null || !p.IsValid) return HookResult.Continue;
        var data = GetData(p);
        var rp = data.GetRace(data.CurrentRaceId);
        _races.GetBehavior(data.CurrentRaceId)?.OnSpawn(BuildCtx(data, rp));
        return HookResult.Continue;
    }

    private HookResult OnRoundEnd(EventRoundEnd ev, GameEventInfo info)
    {
        foreach (var data in _online.Values)
        {
            var def = _races.Get(data.CurrentRaceId);
            if (def == null) continue;
            var rp = data.GetRace(data.CurrentRaceId);
            LevelSystem.AddXp(data, rp, def.TierEnum, LevelSystem.XpRoundWin);
            EconomySystem.AddGold(data, EconomySystem.GoldRoundWin);
            _store.Save(data);
        }
        return HookResult.Continue;
    }

    private GameContext BuildCtx(PlayerData data, RaceProgress rp) =>
        new() { Player = data, Race = rp, Engine = new Cs2EngineApi() };

    // ===== Команды =====
    private void CmdWcsMenu(CCSPlayerController? p, CommandInfo cmd)
    {
        if (p == null) return;
        var data = GetData(p);
        var def = _races.Get(data.CurrentRaceId);
        p.PrintToChat($" \x04[WCS Infinity]\x01 Раса: {def?.Name} | Дивизион: {data.Division} | Золото: {data.Gold}");
        p.PrintToChat(" Команды: !races !rank !shop !ult !reset");
    }

    private void CmdRaces(CCSPlayerController? p, CommandInfo cmd)
    {
        if (p == null) return;
        var data = GetData(p);
        var available = _races.RacesForDivision(data.Division).Take(15).ToList();
        p.PrintToChat($" \x04[WCS]\x01 Доступные расы (дивизион {data.Division}):");
        foreach (var r in available)
            p.PrintToChat($"  #{r.Id} {r.Name} [T{r.Tier}]");
        // выбор: !races <id>
        if (cmd.ArgCount > 1 && int.TryParse(cmd.GetArg(1), out var rid) && _races.Get(rid) != null)
        {
            data.CurrentRaceId = rid;
            p.PrintToChat($" \x04[WCS]\x01 Выбрана раса: {_races.Get(rid)!.Name}");
            _store.Save(data);
        }
    }

    private void CmdRank(CCSPlayerController? p, CommandInfo cmd)
    {
        if (p == null) return;
        var data = GetData(p);
        var rp = data.GetRace(data.CurrentRaceId);
        var def = _races.Get(data.CurrentRaceId);
        p.PrintToChat($" \x04[WCS]\x01 {def?.Name}: ур.{rp.Level} | Paragon:{rp.ParagonLevel} | очки:{rp.UnspentPoints}");
        p.PrintToChat($"  Дивизион:{data.Division} | Золото:{data.Gold} | Сезон-ранг:{data.SeasonRank}");
    }

    private void CmdShop(CCSPlayerController? p, CommandInfo cmd) =>
        p?.PrintToChat(" \x04[WCS]\x01 Рулетки: !spin gold | !spin race | !spin donate (см. configs)");

    private void CmdUlt(CCSPlayerController? p, CommandInfo cmd)
    {
        if (p == null) return;
        var data = GetData(p);
        var rp = data.GetRace(data.CurrentRaceId);
        _races.GetBehavior(data.CurrentRaceId)?.OnUltimate(BuildCtx(data, rp));
        p.PrintToChat(" \x04[WCS]\x01 Ультимейт активирован!");
    }

    private void CmdReset(CCSPlayerController? p, CommandInfo cmd)
    {
        if (p == null) return;
        var data = GetData(p);
        var rp = data.GetRace(data.CurrentRaceId);
        int total = rp.SkillLevels.Values.Sum();
        rp.SkillLevels.Clear();
        rp.UnspentPoints += total;
        p.PrintToChat($" \x04[WCS]\x01 Навыки сброшены. Очков: {rp.UnspentPoints}");
        _store.Save(data);
    }
}
